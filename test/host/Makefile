# Host tests: code without hardware access, built and run on the PC.
#   make -C test/host

CC       ?= gcc
CXX      ?= g++
SAN       = -fsanitize=address,undefined -fno-sanitize-recover=all
CXXFLAGS  = -std=c++11 -Wall -Wextra -Werror -O1 -g -I../../ccs -I../../exi $(SAN)
# the EXI codec as generated by OpenV2G: built without -Werror. -Wno-overflow: EncoderChannel.c assigns SIZE_MAX
# to a uint32_t, which only overflows on a 64-bit PC.
CFLAGS    = -std=gnu99 -O1 -g -Wno-overflow -I../../exi $(SAN)

APPHAND_C = ../../exi/appHandRequest.c ../../exi/appHandEXIDatatypes.c ../../exi/appHandEXIDatatypesEncoder.c \
            ../../exi/appHandEXIDatatypesDecoder.c ../../exi/BitInputStream.c ../../exi/BitOutputStream.c \
            ../../exi/ByteStream.c ../../exi/DecoderChannel.c ../../exi/EncoderChannel.c \
            ../../exi/EXIHeaderDecoder.c ../../exi/EXIHeaderEncoder.c ../../exi/MethodsBag.c

all: run

v2gtp_test: v2gtp_test.cpp ../../ccs/v2gtp.cpp ../../ccs/v2gtp.h
	$(CXX) $(CXXFLAGS) -o $@ v2gtp_test.cpp ../../ccs/v2gtp.cpp

qcaframe_test: qcaframe_test.cpp ../../ccs/qcaframe.cpp ../../ccs/qcaframe.h
	$(CXX) $(CXXFLAGS) -o $@ qcaframe_test.cpp ../../ccs/qcaframe.cpp

apphand_test: apphand_test.cpp $(APPHAND_C) ../../exi/appHandRequest.h
	$(CC) $(CFLAGS) -c $(APPHAND_C)
	$(CXX) $(CXXFLAGS) -o $@ apphand_test.cpp *.o
	rm -f *.o

run: v2gtp_test qcaframe_test apphand_test
	./v2gtp_test
	./qcaframe_test
	./apphand_test

clean:
	rm -f v2gtp_test qcaframe_test apphand_test *.o

.PHONY: all run clean
